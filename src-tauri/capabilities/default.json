{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Curie reads and writes .curie lesson files the user opens, and keeps its library and settings in the app data folder.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "**"
        }
      ]
    },
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-open",
    "fs:allow-read",
    "fs:allow-fstat"
  ]
}
