{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Curie reads and writes .curie lesson files the user opens, keeps its library, notes and settings in the app data folder, and calls the AI provider the user configures (Claude, OpenAI-compatible endpoints, or Ollama, including on the local network).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "**"
        }
      ]
    },
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-open",
    "fs:allow-read",
    "fs:allow-fstat",
    "fs:allow-read-dir",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*:*"
        },
        {
          "url": "http://*:*"
        }
      ]
    }
  ]
}
